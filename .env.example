# Database Configuration (MySQL 8.0)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=github_bot
DB_USERNAME=root
DB_PASSWORD=your_mysql_password_here

# GitHub Webhook Security
GITHUB_WEBHOOK_SECRET=your_custom_webhook_secret_here

# GitHub API Automation (For adding labels and posting comments)
GITHUB_BOT_TOKEN=your_github_token_here

# GitHub OAuth2 (For Dashboard Sign-in)
GITHUB_CLIENT_ID=your_oauth_client_id_here
GITHUB_CLIENT_SECRET=your_oauth_client_secret_here

# Slack Incoming Webhook (For notifications)
SLACK_WEBHOOK_URL=https://your-slack-incoming-webhook-url-here

# Google Gemini AI Studio (Optional stretch goal - free tier)
GEMINI_API_KEY=your_gemini_api_key_here
